<header>
    <div class="header-container">
        <div class="logo">
            <a href="{{ path('app_home') }}">
                <img src="{{ asset('images/logo.svg') }}" alt="Green Goodies Logo" />
            </a>
        </div>
        <nav class="navigation">
            <ul class="nav-links">
                <li><a href="{{ path('app_home') }}" data-text="Nos Produits">Nos produits</a></li>
                {% if app.user %}
                    <li><a href="{{ path('app_cart') }}" data-text="Mon Panier">Mon panier</a></li>
                    <li><a href="{{ path('app_profile') }}" data-text="Mon compte">Mon compte</a></li>
                    <li><a href="{{ path('app_logout') }}" data-text="Deconnexion">Déconnexion</a></li>
                {% else %}
                    <li><a href="{{ path('app_login') }}" data-text="Connexion">Connexion</a></li>
                    <li><a href="{{ path('app_register') }}" data-text="Inscription">Inscription</a></li>
                {% endif %}
            </ul>
        </nav>
    </div>
</header>