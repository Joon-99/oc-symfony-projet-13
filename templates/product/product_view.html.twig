{# @var product \App\Entity\Product #}
{# @var cartItem \App\Entity\CartItem|null #}
{% extends 'base.html.twig' %}

{% block title %}Product - {{ product.name }}{% endblock %}

{% block content %}
    <section class="product-view-section">
        <div class="product-view-image-container">
            <img src="{{ asset(product.picturePath) | imagine_filter('compress') }}" alt="Picture of {{ product.name }}">
        </div>
        <div class="product-view-info-container">
            <h1 class="product-view-name semi-bold-text text-xxl">{{ product.name }}</h1>
            <p class="product-view-price thin-text text-3xl">{{ product.price|replace({".": ","}) }}€</p>
            <p class="product-view-label text-xs grey-text">Description</p>
            <p class="product-view-long-description grey-text">{{ product.longDescription|nl2br }}</p>
            {{ form_start(addToCartForm, {'attr': {'class': 'product-view-form contents-form'}}) }}
                <div class="product-view-quantity-field">
                    {{ form_label(addToCartForm.quantity, null, {'label_attr': {'class': 'product-view-quantity-label text-xs grey-text'}}) }}
                    {{ form_errors(addToCartForm.quantity) }}
                    {{ form_widget(addToCartForm.quantity, {'attr': {'class': 'product-view-quantity-input text-sm'}}) }}
                </div>
                {% set buttonTxt = cartItem ? 'Mettre à jour le panier' : 'Ajouter au panier' %}
                <button type="submit" class="product-view-button cta-grey-button">{{ buttonTxt }}</button>
            {{ form_end(addToCartForm) }}
        </div>
    </section>
{% endblock %}
