{# Reusable one-line-call macro for a CSRF-protected POST button, so state-changing actions never need a hand-rolled <form> #}
{% macro post_action(route, params, label, class, onclick=null) %}
    <form action="{{ path(route, params) }}" method="post" class="contents-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token(route) }}">
        <button type="submit" class="{{ class }}" {% if onclick %}onclick="{{ onclick }}"{% endif %}>{{ label }}</button>
    </form>
{% endmacro %}
