{% extends 'base.html.twig' %}

{% block title %}Hello CartController!{% endblock %}

{% block content %}
<section class="cart-section">
    <h1 class="semi-bold-text text-xxl">Panier</h1>
    {% if cartItems is empty %}
        <p class="grey-text text-s">Votre panier est vide.</p>
    {% else %}
        <ul class="cart-items">
            {% for item in cartItems %}
                <li class="cart-item">
                    {{ item.product.name }} - {{ item.quantity }}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
{% endblock %}
